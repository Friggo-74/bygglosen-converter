# Miljövariabler för Bygglösen Converter
# Kopiera denna fil till .env och fyll i värdena

# Clerk-nycklar – hämtas från https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Din e-postadress som ges admin-behörighet i appen (lämna tom för att inaktivera admin-sidan)
ADMIN_EMAIL=

# Hemlig nyckel för Flask-sessioner (generera en slumpmässig sträng)
SECRET_KEY=byt-ut-den-har

# (Valfritt) Godkänd domän för Clerk-token, t.ex. https://bygglosen.railway.app
# Lämna tom under lokal utveckling
CLERK_AUTHORIZED_PARTY=
